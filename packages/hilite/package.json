{
  "name": "hilite",
  "version": "0.1.0",
  "description": "Syntax highlighting with the TextMate grammars and themes VS Code uses, on the JavaScript regex engine. No WebAssembly.",
  "keywords": [
    "highlight",
    "no-wasm",
    "shiki",
    "syntax-highlighter",
    "syntax-highlighting",
    "textmate",
    "tm-grammar",
    "vscode"
  ],
  "homepage": "https://github.com/JiriMachynka/hilite#readme",
  "bugs": "https://github.com/JiriMachynka/hilite/issues",
  "license": "MIT",
  "author": "Jiří Machynka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JiriMachynka/hilite.git",
    "directory": "packages/hilite"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./langs/*": "./dist/data/langs/*.js",
    "./themes/*": "./dist/data/themes/*.js",
    "./deps": "./dist/data/deps.js",
    "./aliases": "./dist/data/aliases.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build.ts",
    "prepublishOnly": "bun build.ts",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=20"
  }
}
